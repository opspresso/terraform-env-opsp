{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ChangeK3sHostedZone",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": ${jsonencode(hosted_zone_arns)}
    },
    {
      "Sid": "ReadRoute53ForDns01",
      "Effect": "Allow",
      "Action": [
        "route53:GetChange",
        "route53:ListHostedZonesByName",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "*"
    }
  ]
}
