{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NexusImagePullCredential",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:${region}:${account_id}:parameter/k8s/common/nexus/runway-reader-password"
    },
    {
      "Sid": "OwnEnvironmentVariables",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:${region}:${account_id}:parameter/agent-runway/${cluster_name}/$${aws:PrincipalTag/delivery-project}/$${aws:PrincipalTag/delivery-env}",
        "arn:aws:ssm:${region}:${account_id}:parameter/agent-runway/${cluster_name}/$${aws:PrincipalTag/delivery-project}/$${aws:PrincipalTag/delivery-env}/*"
      ]
    },
    {
      "Sid": "DecryptVariables",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "${kms_key_arn}",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.${region}.amazonaws.com"
        }
      }
    }
  ]
}
