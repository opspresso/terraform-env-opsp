{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TargetVariables",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameters", "ssm:DeleteParameters"],
      "Resource": ${jsonencode(concat(
        [for name in target_names : "arn:${partition}:ssm:${region}:${account_id}:parameter/agent-runway/${name}/*"],
        ["arn:${partition}:ssm:${region}:${account_id}:parameter/agent-runway/_runway/*"],
      ))}
    },
    {
      "Sid": "AccountChoices",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeRouteTables",
        "eks:ListClusters", "eks:DescribeCluster",
        "acm:ListCertificates",
        "route53:ListHostedZones",
        "elasticbeanstalk:ListAvailableSolutionStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VariableKey",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "${secrets_key_arn}",
      "Condition": {"StringEquals": {"kms:ViaService": "ssm.${region}.amazonaws.com"}}
    }
  ]
}
